{
  "entities": {
    "Medicine": {
      "title": "Medicine",
      "description": "Pharmaceutical product inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "generic": { "type": "string" },
        "category": { "type": "string" },
        "manufacturer": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" }
      },
      "required": ["id", "name", "price", "stock"]
    },
    "Backup": {
      "title": "Backup",
      "description": "Full pharmacy snapshot and cloud sync record",
      "type": "object",
      "properties": {
        "exportDate": { "type": "string" },
        "lastSyncedAt": { "type": "string" },
        "projectId": { "type": "string" }
      },
      "required": ["exportDate", "projectId"]
    },
    "UserDueSnapshot": {
      "title": "UserDueSnapshot",
      "description": "Account-based persistent due ledger and transaction snapshot",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "customers": { "type": "array" },
        "suppliers": { "type": "array" },
        "sales": { "type": "array" },
        "purchaseOrders": { "type": "array" },
        "expenses": { "type": "array" },
        "lastSyncedAt": { "type": "string" }
      },
      "required": ["userId", "lastSyncedAt"]
    },
    "SaleTransaction": {
      "title": "SaleTransaction",
      "description": "Persistent individual sales invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "date", "grandTotal"]
    },
    "PurchaseTransaction": {
      "title": "PurchaseTransaction",
      "description": "Persistent individual supplier purchase invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" },
        "orderDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "poNumber", "orderDate", "totalAmount"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Persistent pharmacy petty expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "category", "amount", "date"]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Persistent linked regular customer profile with due balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "dueAmount": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "totalSpent": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "SupplierProfile": {
      "title": "SupplierProfile",
      "description": "Persistent linked medicine supplier/wholesaler profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "dueBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/backups/{backupId}": {
      "schema": "Backup",
      "description": "Stores state backups"
    },
    "/medicines/{medicineId}": {
      "schema": "Medicine",
      "description": "Stores pharmacy medicines"
    },
    "/users/{userId}/dueLedger/snapshot": {
      "schema": "UserDueSnapshot",
      "description": "Stores account-based due ledger state, customer balances, and transaction history"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "CustomerProfile",
      "description": "Stores persistent linked customer entities"
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": "SupplierProfile",
      "description": "Stores persistent linked supplier entities"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "SaleTransaction",
      "description": "Stores individual persistent sales transaction records"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "PurchaseTransaction",
      "description": "Stores individual persistent purchase transaction records"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "ExpenseRecord",
      "description": "Stores individual persistent expense records"
    }
  }
}
